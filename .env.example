# AetherFrame 3D Studio — Environment Configuration Example
# Copy this file to .env and configure values as needed. Never commit real API keys.

# Server Port (Default: 3000)
PORT=3000

# Optional: Gemini API Key for AI Storyboard Generation (Server-side only)
GEMINI_API_KEY=

# VoiceStudio (k2-fsa/OmniVoice) Local Service Configuration
# Default local VoiceStudio address: http://localhost:3900
VOICESTUDIO_API_URL=http://localhost:3900

# Optional: VoiceStudio Admin / Server-Mode API Key (required for Docker NAT deployments)
OMNIVOICE_API_KEY=

# Persistent Model & Voice Data Directory for VoiceStudio
OMNIVOICE_DATA_DIR=/app/applet/.voicestudio_data
OMNIVOICE_CACHE_DIR=/app/applet/.voicestudio_data/cache

# Optional: PyTorch compute variant override (auto | cpu | cuda | rocm)
OMNIVOICE_TORCH_VARIANT=auto
